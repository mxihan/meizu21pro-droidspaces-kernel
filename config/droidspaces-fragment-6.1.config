# Droidspaces feature fragment for Meizu 21 Pro / PixelOS 17.
# Audited 2026-10-19 against stock Linux 6.1.176-g19e9b13339e2.
# Source: meizu-8650-kernel/android_kernel_meizu_sm8650
# Commit: 19e9b13339e26612844b620c2bdd54228dc6d836
# Droidspaces source: 8b625e110270e2f0d32004f740b1e9a71b1f540c
# Apply an adapted SYSVIPC task_struct KABI patch using slots 6,7,8 FIRST.
# This is a feature request, not proof of KMI compatibility. Compare the
# baseline/final .config, Module.symvers and ABI before a boot image is used.

# Core namespaces and IPC. POSIX_MQUEUE and IPC_NS were already enabled.
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# Runtime security and normal init/terminal facilities.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_UNIX98_PTYS=y
CONFIG_KEYS=y
CONFIG_INOTIFY_USER=y
CONFIG_KCMP=y
CONFIG_FHANDLE=y

# Preserve the working Android cgroup controllers and BPF device path.
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y

# Preserve the stock values of options that change shared kernel layouts.
# CONFIG_CFS_BANDWIDTH is not set
# CONFIG_CGROUP_PIDS is not set
# CONFIG_CGROUP_DEVICE is not set
# CONFIG_NF_TABLES is not set
# CONFIG_BRIDGE_NETFILTER is not set

# Sparse ext4 rootfs, hardware access, volatile mode, NixOS and FUSE.
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_DEVTMPFS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FUSE_FS=y
CONFIG_AUTOFS_FS=y

# User namespaces are compiled in for optional per-container sandboxing.
# The Droidspaces Allow Sandboxing option remains a runtime choice.
CONFIG_USER_NS=y

# IPv4 isolated NAT / port forwarding; most of these are stock=y.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_NET_NS=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# IPv6 NAT66. Availability of an IPv6 upstream remains a runtime condition.
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# Optional LAN attachment and VPN support.
CONFIG_MACVLAN=y
CONFIG_TUN=y

# UFW / Fail2Ban with the legacy iptables backend.
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# Preserve module version checks and host SELinux support.
CONFIG_MODVERSIONS=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y

# Not part of the first profile: nftables, bridge netfilter, NFS/CIFS,
# IPVS/Swarm/VXLAN, new cgroup controllers, broad hardware drivers.
# Do not add removed symbols such as MEMCG_SWAP, CGROUP_NS,
# DEVPTS_MULTIPLE_INSTANCES, NF_CONNTRACK_IPV4/6, NF_NAT_IPV4/6,
# NF_CONNTRACK_NETLINK or NETFILTER_XT_TARGET_REJECT.

